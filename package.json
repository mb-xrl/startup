{
  "name": "nexa-workspace",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "install:all": "npm install --prefix server && npm install --prefix web",
    "db:init": "npm run db:init --prefix server",
    "dev": "concurrently -n api,web -c blue,magenta \"npm:dev --prefix server\" \"npm:dev --prefix web\"",
    "build": "npm run build --prefix web && npm run build:server",
    "build:web": "npm run build --prefix web",
    "build:server": "echo 'server needs no build step'",
    "build:vercel": "npm install --prefix web && npm run build --prefix web",
    "start": "npm start --prefix server"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/multipart": "^9.0.1",
    "@fastify/static": "^8.0.3",
    "bcryptjs": "^2.4.3",
    "fastify": "^5.0.0",
    "nanoid": "^5.0.7",
    "sql.js": "^1.12.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "concurrently": "^9.0.1"
  }
}
